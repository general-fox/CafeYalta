# Только локальный сервер. Эти значения нельзя переносить в VITE_* или GitHub Pages.
# Скопируйте этот файл в server/.env. Файл .env исключён из Git.

# Приложение на https://api.iiko.help/portal
IIKO_APP_ID=
IIKO_CLIENT_SECRET=

# Ключ тестового предприятия из iikoWeb (ранее назывался apiLogin)
IIKO_API_KEY=

# Заполните после npm run iiko:check — команда покажет доступные ID.
IIKO_ORGANIZATION_ID=
IIKO_EXTERNAL_MENU_ID=

# Необязательно: ценовая категория доставки.
IIKO_PRICE_CATEGORY_ID=

API_PORT=3001
